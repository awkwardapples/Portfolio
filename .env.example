# =============================================================================
# Environment variable reference — SCB Handyman (Growth Ops Platform)
# =============================================================================
#
# IMPORTANT — read before using this file:
#
# This project does NOT currently load a `.env` file at runtime. WordPress
# has no native `.env` support, and this plugin's own config layer
# (plugins/quote-wizard/src/Support/Settings.php) reads secrets from
# `wp-config.php` PHP constants (or, as a fallback, `wp_options` — see
# below), never from a `.env` file. The Vite/React frontend
# (apps/wizard/) uses ZERO environment variables of any kind — confirmed
# via a full audit for `import.meta.env`/`VITE_*` usage, which found none.
#
# This file exists as the single, canonical reference for every sensitive
# value this deployment needs — names and comments only, no real values,
# safe to commit. Copy the values below into `wp-config.php` as PHP
# `define()` constants (see the "Where it goes" line on each entry), NOT
# into a literal `.env` file that nothing in this codebase reads.
#
# Never commit a real `.env`, `.env.local`, `.env.production`, or any
# `.env.*.local` file — `.gitignore` blocks all of these (a single `.env*`
# pattern, with this file explicitly re-allowed via `!.env.example`).
#
# =============================================================================
# SERVER-ONLY SECRETS — must never reach the browser or the compiled bundle
# =============================================================================

# Make.com webhook URL that receives quote-wizard submissions (notifications,
# WhatsApp template trigger, Google Sheet logging). Treat as a bearer
# credential: anyone with this URL can POST fabricated submissions into the
# business's live automation. Rotate immediately if ever exposed publicly.
# Where it goes: wp-config.php -> define( 'GOQW_MAKE_WEBHOOK_URL', '...' );
# (falls back to the wp_options row `goqw_webhook_url` if the constant is
# undefined — the constant is the more secure of the two, since it never
# appears in a database dump or the WP Options table.)
GOQW_MAKE_WEBHOOK_URL=

# Cloudflare Turnstile SECRET key — used only server-side, to verify a
# widget token via Cloudflare's siteverify API before a submission is
# accepted (plugins/quote-wizard/src/Support/TurnstileClient.php). This is
# the counterpart to the PUBLIC site key below — never expose this one.
# Where it goes: wp-config.php -> define( 'GOQW_TURNSTILE_SECRET_KEY', '...' );
# (falls back to the wp_options row `goqw_turnstile_secret_key`.)
GOQW_TURNSTILE_SECRET_KEY=

# Internal agency/business email that receives operational notifications
# separate from the customer-facing business email below. Not a credential,
# but internal — not meant for public documentation.
# Where it goes: wp-config.php -> define( 'GOQW_AGENCY_NOTIFICATION_EMAIL', '...' );
# (falls back to the wp_options row `goqw_agency_notification_email`, then
# to WordPress's own `admin_email` option.)
GOQW_AGENCY_NOTIFICATION_EMAIL=

# =============================================================================
# PUBLIC / BROWSER-SAFE VALUES — safe to expose, listed here for completeness
# =============================================================================

# Cloudflare Turnstile SITE key. By Cloudflare's own design this is meant to
# be embedded in client-side HTML — it is not a secret, and IS exposed to
# the browser via window.GOQW_CONFIG (plugins/quote-wizard/src/Frontend/
# PublicConfig.php). Included here only so the site/secret pair is
# documented together.
# Where it goes: wp_options row `goqw_turnstile_site_key` (set via wp-admin
# or `wp option update goqw_turnstile_site_key "..."` — no constant needed
# since it's not sensitive).
TURNSTILE_SITE_KEY=

# =============================================================================
# WORDPRESS CORE — standard wp-config.php values, not specific to this plugin
# =============================================================================
# Every WordPress install needs these regardless of this plugin. Listed here
# only because the audit brief asked for database credentials to be covered.

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=

# =============================================================================
# NOT USED BY THIS CODEBASE (documented so nobody re-invents them)
# =============================================================================
# SMTP / transactional email credentials: this plugin sends no email of its
# own — notifications go through the Make.com webhook above. If a
# site-wide SMTP plugin (e.g. WP Mail SMTP) is ever added for WordPress's
# own core emails, its credentials belong to THAT plugin's own settings UI,
# not to this file or this codebase.

---
/**
 * The real 404 page (spec F.1). The Worker's asset handler serves it with a
 * 404 status for any unknown path (`not_found_handling: "404-page"`), so
 * search engines never see a soft 404.
 */
import Button from '~/components/Button.astro';
import Section from '~/components/Section.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found | Josh Lennon"
  description="There is no page at this address."
  noindex
>
  <Section labelledby="not-found-heading" width="reading">
    <h1 id="not-found-heading" class="text-3xl">Page not found</h1>
    <p class="mt-6 text-reading">
      There is no page at this address. It may have moved, or the link may have a typo.
    </p>
    <p class="mt-8">
      <Button href="/">Go to the homepage</Button>
    </p>
  </Section>
</BaseLayout>

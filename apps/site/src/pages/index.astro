---
/**
 * The homepage (spec G). A first visit opens on the threshold; everyone
 * else, and every crawler and screen reader, gets the same sections in the
 * same HTML. Sections whose content has not arrived are left out of
 * production builds, and the threshold only offers answers whose section is
 * on the page (spec T.4); `astro dev` shows them as labelled gaps.
 */
import Elsewhere from '~/components/home/Elsewhere.astro';
import GetInTouch from '~/components/home/GetInTouch.astro';
import GrowTrades from '~/components/home/GrowTrades.astro';
import Intro from '~/components/home/Intro.astro';
import Lately from '~/components/home/Lately.astro';
import Music from '~/components/home/Music.astro';
import Pending from '~/components/home/Pending.astro';
import ResearchShelf, { type ShelfItem } from '~/components/home/ResearchShelf.astro';
import SelectedWork from '~/components/home/SelectedWork.astro';
import Threshold from '~/components/home/Threshold.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { bibtexCitation, plainCitation } from '~/lib/citation';
import { dateOf, getFeaturedWork, getPosts, getProfile, getWork } from '~/lib/content';
import { publicFileSize } from '~/lib/documents';
import { intentCtas, selectWork, type HomeSection } from '~/lib/home';
import { INTENTS } from '~/lib/intents';
import { hasMusic, musicContent } from '~/lib/music';
import { ROUTES, isLinkable } from '~/lib/routes';
import { website } from '~/lib/structured-data';
import { citationInput } from '~/lib/work';

const sentence =
  "I studied Artificial Intelligence at the University of Manchester, I'm studying for an MSc in Artificial Intelligence at the University of Surrey, I founded GrowTrades, and I make music.";

const profile = await getProfile();
const work = await getWork();
const posts = await getPosts();
const selected = selectWork(await getFeaturedWork(), work);

// The shelf: the newest documents across all work, up to three (spec G.3).
const site = Astro.site ?? new URL('https://joshlennon.com');
const shelf: ShelfItem[] = work
  .flatMap((entry) => {
    const date = dateOf(entry.data.date);
    return entry.data.documents.map((document) => {
      const input = date
        ? citationInput(entry.data, document, {
          name: profile.citationName ?? profile.name,
          site,
          date,
        })
        : undefined;
      return {
        document,
        summary: entry.data.summary,
        date,
        work: { href: `${ROUTES.work.path}/${entry.id}`, title: entry.data.title },
        citation: input && { plain: plainCitation(input), bibtex: bibtexCitation(input) },
      };
    });
  })
  .slice(0, 3);

// GrowTrades appears with its entry (published, or a draft in development).
const growtrades = work.find((entry) => entry.id === 'growtrades');
const sections = new Set<HomeSection>(['intro', 'get-in-touch']);
if (selected.length > 0) sections.add('selected-work');
if (shelf.length > 0) sections.add('research');
if (growtrades) sections.add('growtrades');
// Music appears once there is music in the content (spec G.5).
const music = musicContent(work);
const showMusic = hasMusic(music);
if (showMusic) sections.add('music');

const cv = profile.cv && { href: profile.cv.file, size: publicFileSize(profile.cv.file) };
const ctas = intentCtas({
  sections,
  cv,
  pages: {
    contact: isLinkable(ROUTES.contact),
    research: isLinkable(ROUTES.research),
    music: isLinkable(ROUTES.music) && showMusic,
    growtrades: isLinkable(ROUTES.work) && growtrades !== undefined,
  },
});
const options = INTENTS.filter((intent) => sections.has(intent.target as HomeSection));
---

<BaseLayout
  title="Josh Lennon"
  description={sentence}
  structuredData={[website(site.origin, profile.name)]}
>
  <Threshold sentence={sentence} options={options} />
  <Intro profile={profile} ctas={ctas} />
  {selected.length > 0 && <SelectedWork entries={selected} />}
  {shelf.length > 0 && <ResearchShelf items={shelf} />}
  {growtrades && <GrowTrades entry={growtrades} />}
  {
    showMusic ? (
      <Music artistName={profile.artistName} content={music} />
    ) : (
      <Pending
        id="music"
        title="Music"
        surface="stage"
        needs="Needs a music entry with Josh's footage loop, a release and the Spotify link"
      />
    )
  }
  <Lately posts={posts} />
  <Elsewhere profile={profile} />
  <GetInTouch profile={profile} />
</BaseLayout>

---
/**
 * Placeholder homepage until Pass 4 builds the threshold and the homepage
 * sections (spec G): the name and the confirmed one-sentence introduction
 * (spec G.0) on stage.
 */
import Section from '~/components/Section.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';

const intro =
  "I studied Artificial Intelligence at the University of Manchester, I'm studying for an MSc in Artificial Intelligence at the University of Surrey, I founded GrowTrades, and I make music.";
---

<BaseLayout title="Josh Lennon" description={intro}>
  <Section surface="stage" labelledby="intro-heading">
    <h1 id="intro-heading" class="text-display">Josh Lennon</h1>
    <p class="mt-8 max-w-reading text-lg text-fog">{intro}</p>
  </Section>
</BaseLayout>

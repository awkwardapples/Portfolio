---
/**
 * A page section on paper or stage (spec E.1, E.4). Vertical rhythm comes
 * from the section tokens: 64 px on phones, 80 on tablets, 128 on desktop.
 * Stage sections are full-bleed; their content still sits on the grid.
 */
interface Props {
  id?: string;
  surface?: 'paper' | 'stage';
  /** The id of the section's heading, for aria-labelledby. */
  labelledby?: string;
  /** `content` (1200 px), `reading` (68 characters) or `full` (no container). */
  width?: 'content' | 'reading' | 'full';
  /** A hairline rule above the content, between consecutive paper sections. */
  divided?: boolean;
  class?: string;
}

const {
  id,
  surface = 'paper',
  labelledby,
  width = 'content',
  divided = false,
  class: className,
} = Astro.props;
---

<section
  id={id}
  data-surface={surface}
  aria-labelledby={labelledby}
  class:list={[
    divided
      ? 'pb-section-sm sm:pb-section-md lg:pb-section-lg'
      : 'py-section-sm sm:py-section-md lg:py-section-lg',
    className,
  ]}
>
  {
    width === 'full' ? (
      <slot />
    ) : (
      <div
        class:list={[
          'mx-auto px-4 sm:px-6 lg:px-8',
          width === 'reading' ? 'max-w-reading' : 'max-w-content',
          divided && 'border-t border-rule pt-section-sm sm:pt-section-md lg:pt-section-lg',
        ]}
      >
        <slot />
      </div>
    )
  }
</section>

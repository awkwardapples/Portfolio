---
/**
 * What someone else said about the work (Pass 11, F.2), with its public
 * source. With a screenshot (Josh's choice, 11 November 2026), the comment
 * is shown as it appears there, and the screenshot itself links to it, in a
 * new tab; its alternative text gives who said it and the words verbatim.
 * Without one, the quotation in STIX Two Text at the lead size, marked by a
 * 4 px tungsten rule, then who said it and a link.
 *
 * No Review structured data: self-serving review markup is against search
 * guidelines.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { ExternalLink } from 'lucide-react';

interface Props {
  endorsement: {
    quote: string;
    name?: string | undefined;
    role: string;
    organisation: string;
    context: string;
    url: string;
    /** From the content collection; an MDX body passes `screenshot` instead. */
    screenshot?: ImageMetadata | string | undefined;
  };
  screenshot?: ImageMetadata | undefined;
  class?: string;
}

const { endorsement, screenshot: given, class: className } = Astro.props;
const { quote, name, role, organisation, context, url } = endorsement;
const screenshot =
  given ?? (typeof endorsement.screenshot === 'object' ? endorsement.screenshot : undefined);
const who = [name, role, organisation, context].filter(Boolean).join(', ');
const source = /linkedin\.com|lnkd\.in/.test(url) ? 'LinkedIn' : new URL(url).hostname;
---

{
  screenshot ? (
    <figure class:list={['flex flex-col', className]}>
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="block self-start rounded-media"
        data-endorsement-link
      >
        <Picture
          src={screenshot}
          alt={`${who}, on ${source}: "${quote}"`}
          formats={['avif', 'webp']}
          widths={[360, screenshot.width].filter((width) => width <= screenshot.width)}
          sizes="(min-width: 1024px) 32rem, 100vw"
          loading="lazy"
          decoding="async"
          class="h-auto w-full max-w-lg rounded-media"
        />
        <span class="sr-only"> (opens the comment on {source} in a new tab)</span>
      </a>
    </figure>
  ) : (
    <figure class:list={['flex flex-col gap-4', className]}>
      <blockquote cite={url} class="border-l-4 border-tungsten pl-5 font-serif text-lg">
        <p>{quote}</p>
      </blockquote>
      <figcaption class="flex flex-col gap-1 pl-6 text-sm">
        <span>{who}.</span>
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center gap-2 self-start underline underline-offset-4"
        >
          View the comment on {source}
          <span class="sr-only"> (opens in a new tab)</span>
          <ExternalLink aria-hidden="true" size={16} strokeWidth={1.75} />
        </a>
      </figcaption>
    </figure>
  )
}

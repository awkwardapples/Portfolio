---
/**
 * Under the hood (spec J.2 item 4, N.5; Pass 11, F.5): a case study's
 * pipeline, step by step, each beside the real artefact that does it (code
 * or a trace line), cut at build time (src/lib/excerpt.ts fails the build if
 * the code moves), with links to where it lives. The steps are data:
 * src/lib/pipelines/growtrades.ts (the submission pipeline, from this
 * repository, with its decision records) and src/lib/pipelines/arbiter.ts
 * (how Arbiter reasons, from its repository at the pinned commit).
 *
 * Wider screens with JavaScript: the steps scroll on the left while the
 * right-hand panel stays put and shows the artefact for the step in view.
 * Phones, and anyone without JavaScript: each step is followed by its
 * artefact, which scrolls sideways when it is wide and so takes keyboard
 * focus. Nothing animates; the panel swaps.
 */
import { ARBITER_STEPS } from '~/lib/pipelines/arbiter';
import { GROWTRADES_STEPS } from '~/lib/pipelines/growtrades';

interface Props {
  pipeline?: 'growtrades' | 'arbiter';
}

const { pipeline = 'growtrades' } = Astro.props;
const steps = pipeline === 'arbiter' ? ARBITER_STEPS : GROWTRADES_STEPS;
---

<div class="under-the-hood grid gap-10 md:grid-cols-2 md:gap-12" data-under-the-hood>
  <ol class="flex min-w-0 flex-col" role="list">
    {
      steps.map((step, index) => (
        <li class="uth-step border-t border-rule py-8" data-step={index}>
          <h3 class="text-xl">{step.title}</h3>
          <p class="mt-2 max-w-reading">{step.text}</p>
          <p class="mt-2 flex flex-wrap gap-x-4 text-sm">
            {step.links.map((link) => (
              <a href={link.href} class="inline-flex min-h-11 items-center underline underline-offset-4">
                {link.label}
              </a>
            ))}
          </p>
          {step.artefacts.map((artefact) => (
            <pre class="uth-code uth-inline mt-4" tabindex="0"><code>{artefact.code}</code></pre>
          ))}
        </li>
      ))
    }
  </ol>
  <div class="uth-panel min-w-0" aria-hidden="true">
    <div class="sticky top-24">
      {
        steps.map((step, index) => (
          <div class="uth-artefact" data-artefact={index} hidden={index !== 0}>
            {step.artefacts.map((artefact) => (
              <figure>
                <figcaption class="mb-2 text-xs text-graphite">{artefact.caption}</figcaption>
                <pre class="uth-code"><code>{artefact.code}</code></pre>
              </figure>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</div>

<script>
  // The step in the middle of the screen chooses the panel's code (spec N.5).
  for (const root of document.querySelectorAll<HTMLElement>('[data-under-the-hood]')) {
    const artefacts = Array.from(root.querySelectorAll<HTMLElement>('[data-artefact]'));
    const show = (index: string) => {
      for (const artefact of artefacts) artefact.hidden = artefact.dataset.artefact !== index;
    };
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) show((entry.target as HTMLElement).dataset.step ?? '0');
        }
      },
      { rootMargin: '-45% 0px -45% 0px' },
    );
    root.querySelectorAll('[data-step]').forEach((step) => observer.observe(step));
  }
</script>

<style>
  /* Some steps show two artefacts; [hidden] still wins, since no display class is set. */
  .uth-artefact:not([hidden]) {
    display: flex;
    flex-direction: column;
    gap: theme('spacing.4');
  }

  /* A tall step scrolls inside the panel rather than running past the screen. */
  .uth-panel .sticky {
    max-height: calc(100vh - theme('spacing.32'));
    overflow-y: auto;
  }

  .uth-code {
    overflow-x: auto;
    border-radius: theme('borderRadius.media');
    background-color: theme('colors.paper-sunken');
    padding: theme('spacing.4');
    font-size: theme('fontSize.xs[0]');
    line-height: 1.5;
    white-space: pre;
  }

  /* The panel exists only on wider screens with JavaScript; otherwise code follows each step. */
  .uth-panel {
    display: none;
  }

  @media (min-width: 768px) {
    :global(html.js) .uth-panel {
      display: block;
    }

    :global(html.js) .uth-inline {
      display: none;
    }

    .uth-step {
      min-height: 40vh;
    }
  }
</style>

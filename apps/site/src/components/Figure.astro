---
/**
 * Evidence as a figure with a real caption (spec E.4). Figures are numbered
 * only where the text refers to them by number (case studies, research).
 * External images always show their credit beside them (spec H.2, H.6).
 * With `zoom`, the image links to its full size, which the lightbox
 * (src/scripts/lightbox.ts, spec N.15) opens in place.
 */
import type { ImageMetadata } from 'astro';
import { Picture, getImage } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string | undefined;
  credit?: { owner: 'josh' | 'external'; name?: string | undefined; url?: string | undefined };
  /** Shown as "Fig. n" when the surrounding text refers to the figure. */
  number?: number;
  /** The sizes attribute for the responsive image. */
  sizes?: string;
  widths?: number[];
  /** Load eagerly with high priority: only for the page's largest image above the fold. */
  priority?: boolean;
  /** Opens the full image in the lightbox; without JavaScript, a link to it. */
  zoom?: boolean;
  class?: string;
}

const {
  src,
  alt,
  caption,
  credit,
  number,
  sizes = '(min-width: 1280px) 1200px, 100vw',
  widths = [480, 800, 1200, 1600, 2400],
  priority = false,
  zoom = false,
  class: className,
} = Astro.props;

const external = credit?.owner === 'external' ? credit : undefined;
const usableWidths = widths.filter((width) => width <= src.width);
const pictureWidths = usableWidths.length > 0 ? usableWidths : [src.width];
const full = zoom
  ? await getImage({ src, width: Math.min(src.width, 2400), format: 'webp' })
  : undefined;
---

<figure class:list={['flex flex-col gap-3', className]}>
  {
    full ? (
      <a href={full.src} class="block" data-lightbox data-caption={caption} data-alt={alt}>
        <Picture
          src={src}
          alt={alt}
          formats={['avif', 'webp']}
          widths={pictureWidths}
          sizes={sizes}
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : undefined}
          decoding="async"
          class="h-auto w-full rounded-media"
        />
        <span class="sr-only"> (open the larger image)</span>
      </a>
    ) : (
      <Picture
        src={src}
        alt={alt}
        formats={['avif', 'webp']}
        widths={pictureWidths}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        decoding="async"
        class="h-auto w-full rounded-media"
      />
    )
  }
  {
    (caption || number !== undefined || external) && (
      <figcaption class="max-w-reading text-xs text-graphite">
        {number !== undefined && <span class="font-medium text-ink">Fig. {number}. </span>}
        {caption}
        {external && (
          <span>
            {' '}
            Image:{' '}
            <a class="underline" href={external.url}>
              {external.name}
            </a>
            .
          </span>
        )}
      </figcaption>
    )
  }
</figure>

<script>
  import '~/scripts/lightbox';
</script>

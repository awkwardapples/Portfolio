---
/**
 * A YouTube video as a facade (spec K.2, N.7, P.2): nothing loads from
 * YouTube until the visitor asks. The title and thumbnail come from oEmbed
 * at build time (src/lib/oembed.ts) and the thumbnail is served from this
 * site, at the width the layout needs (`sizes`), so a phone does not fetch
 * the 1280 px still; without them, a plain stage panel with the content's
 * title.
 *
 * "Play video" is a link to the video on YouTube, so it works without
 * JavaScript; with JavaScript (src/scripts/embeds.ts) it swaps in the
 * privacy-enhanced player and moves focus to it.
 */
import { getImage } from 'astro:assets';

import { buttonClass } from '~/design/button';
import { fetchOembed, firstAvailable, youtubeOembedUrl } from '~/lib/oembed';

interface Props {
  id: string;
  title: string;
  start?: number | undefined;
  playlist?: string | undefined;
  /** How wide the facade shows, for choosing the thumbnail's width. */
  sizes?: string;
  class?: string;
}

const {
  id,
  title: contentTitle,
  start,
  playlist,
  sizes = '(min-width: 1200px) 71rem, 100vw',
  class: className,
} = Astro.props;
const watch = new URL('https://www.youtube.com/watch');
watch.searchParams.set('v', id);
if (playlist) watch.searchParams.set('list', playlist);
if (start) watch.searchParams.set('t', `${start}s`);

const embed = new URL(`https://www.youtube-nocookie.com/embed/${id}`);
embed.searchParams.set('autoplay', '1');
if (playlist) embed.searchParams.set('list', playlist);
if (start) embed.searchParams.set('start', String(start));

const info = await fetchOembed(youtubeOembedUrl(id), contentTitle);
// oEmbed's thumbnail is 480 px wide; YouTube's larger stills are tried first.
const candidates = [
  { url: `https://i.ytimg.com/vi/${id}/maxresdefault.jpg`, width: 1280, height: 720 },
  { url: `https://i.ytimg.com/vi/${id}/sddefault.jpg`, width: 640, height: 480 },
  ...(info.thumbnail ? [info.thumbnail] : []),
];
// Only when oEmbed answered (the build is online); otherwise the plain panel stands in.
const still = info.thumbnail ? await firstAvailable(candidates) : undefined;
// 480 and 800 px for phones (a 412 px screen at a 1.75 pixel ratio needs 721), the full still
// for wide screens.
const widths = still ? [...new Set([480, 800, still.width])].filter((w) => w <= still.width) : [];
const stills = still
  ? await Promise.all(
      widths.map(async (width) => ({
        width,
        src: (
          await getImage({
            src: still.url,
            width,
            height: Math.round((width * still.height) / still.width),
            format: 'avif',
          })
        ).src,
      })),
    )
  : [];
const poster = still
  ? {
      src: stills.at(-1)?.src ?? '',
      srcset: stills.map((image) => `${image.src} ${image.width}w`).join(', '),
      width: still.width,
      height: still.height,
    }
  : undefined;
const title = info.title;
---

<figure class:list={['flex flex-col gap-3', className]}>
  <div
    class="relative flex aspect-video w-full items-center justify-center overflow-hidden rounded-media"
    data-surface="stage"
    data-embed={embed.href}
    data-embed-title={`${title} (YouTube video)`}
    data-embed-allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
  >
    {
      poster ? (
        <img
          src={poster.src}
          srcset={poster.srcset}
          sizes={sizes}
          alt=""
          width={poster.width}
          height={poster.height}
          loading="lazy"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover"
        />
      ) : (
        <p class="absolute inset-x-6 top-6 max-w-reading font-serif text-xl">{title}</p>
      )
    }
    <a href={watch.href} class:list={[buttonClass({ surface: 'stage' }), 'relative']} data-embed-play>
      Play video<span class="sr-only">: {title}</span>
    </a>
  </div>
  <figcaption class="flex flex-col gap-1">
    {poster && <span class="font-serif text-lg">{title}</span>}
    <span class="text-xs text-graphite">Plays from YouTube.</span>
  </figcaption>
</figure>

<script>
  import '~/scripts/embeds';
</script>

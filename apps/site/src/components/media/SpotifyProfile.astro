---
/**
 * Josh's phone screenshot of the artist profile in the Spotify app, linking
 * to the profile (Josh's choice, 7 October 2026). It is a picture of a phone
 * screen, so it keeps its own proportions at a phone's width; the link's name
 * is the screenshot's alt text.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  href: string;
  screenshot: { src: ImageMetadata; alt: string };
  /** The `sizes` for the layout it sits in. */
  sizes: string;
  class?: string;
}

const { href, screenshot, sizes, class: className } = Astro.props;
---

<a href={href} class:list={['block rounded-media', className]}>
  <Picture
    src={screenshot.src}
    alt={screenshot.alt}
    formats={['avif', 'webp']}
    widths={[160, 240, 320, 480].filter((width) => width <= screenshot.src.width)}
    sizes={sizes}
    quality={60}
    loading="lazy"
    decoding="async"
    class="h-auto w-full rounded-media border border-graphite"
  />
</a>

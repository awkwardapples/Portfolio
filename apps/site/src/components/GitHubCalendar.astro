---
/**
 * The GitHub contribution calendar for the last year (spec M.1): discrete
 * squares in five steps from paper to ink (no gradient), a sentence with
 * the total, and a visually hidden table of monthly totals for screen
 * readers. On narrow screens the grid scrolls inside its own box, starting
 * at the most recent weeks (the box is right-to-left; the grid inside is not).
 */
import { calendarWeeks, monthlyTotals, type GitHubSnapshot } from '~/lib/github';

interface Props {
  calendar: GitHubSnapshot['calendar'];
}

const { calendar } = Astro.props;
const weeks = calendarWeeks(calendar.days);
const months = monthlyTotals(calendar.days);
const total = calendar.total.toLocaleString('en-GB');
---

<figure class="flex flex-col gap-3">
  <div class="overflow-x-auto pb-2" dir="rtl">
    <div class="calendar" aria-hidden="true" dir="ltr">
      {
        weeks.map((week) => (
          <div class="calendar-week">
            {week.map((day) =>
              day ? (
                <span class={`calendar-day level-${day.level}`} title={`${day.date}: ${day.count}`} />
              ) : (
                <span class="calendar-day calendar-empty" />
              ),
            )}
          </div>
        ))
      }
    </div>
  </div>
  <figcaption class="text-sm text-graphite">{total} contributions in the last year</figcaption>
  <table class="sr-only">
    <caption>GitHub contributions by month</caption>
    <thead>
      <tr><th scope="col">Month</th><th scope="col">Contributions</th></tr>
    </thead>
    <tbody>
      {
        months.map((month) => (
          <tr>
            <th scope="row">{month.month}</th>
            <td>{month.total}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</figure>

<style>
  .calendar {
    display: flex;
    gap: 3px;
    width: max-content;
  }

  .calendar-week {
    display: grid;
    grid-template-rows: repeat(7, 11px);
    gap: 3px;
  }

  .calendar-day {
    width: 11px;
    height: 11px;
    border-radius: 2px;
  }

  .calendar-empty {
    visibility: hidden;
  }

  .level-0 {
    background-color: theme('colors.paper-sunken');
  }

  .level-1 {
    background-color: theme('colors.rule');
  }

  .level-2 {
    background-color: theme('colors.line-strong');
  }

  .level-3 {
    background-color: theme('colors.graphite');
  }

  .level-4 {
    background-color: theme('colors.ink');
  }
</style>

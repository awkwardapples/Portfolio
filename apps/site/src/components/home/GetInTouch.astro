---
/**
 * Get in touch (spec G.9), a stage band: one sentence, "Start a conversation"
 * once /contact exists, and the profiles that are in profile.yaml. The form
 * is the way in; the email address appears only beside it on /contact.
 */
import Section from '~/components/Section.astro';
import { buttonClass } from '~/design/button';
import type { Profile } from '~/lib/content';
import { ROUTES, isLinkable } from '~/lib/routes';

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
const { linkedin, github } = profile.links;
const profiles = [
  ...(linkedin ? [{ href: linkedin, label: 'LinkedIn' }] : []),
  ...(github ? [{ href: github, label: 'GitHub' }] : []),
];
---

<Section id="get-in-touch" surface="stage" labelledby="get-in-touch-heading">
  <h2 id="get-in-touch-heading" class="text-3xl" tabindex="-1" data-landing>Get in touch</h2>
  <p class="mt-6 max-w-reading text-lg text-fog">
    Whatever brings you here, I'd like to hear from you.
  </p>
  <div class="mt-10 flex flex-col gap-6">
    {
      isLinkable(ROUTES.contact) && (
        <p>
          <a href={ROUTES.contact.path} class={buttonClass({ surface: 'stage' })}>
            {ROUTES.contact.label}
          </a>
        </p>
      )
    }
    {
      profiles.length > 0 && (
        <ul class="flex flex-wrap gap-x-6" role="list">
          {profiles.map((link) => (
            <li>
              <a href={link.href} class={buttonClass({ variant: 'quiet', surface: 'stage' })}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Section>

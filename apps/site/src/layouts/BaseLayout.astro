---
/**
 * The document shell every page uses: head tags (Seo.astro), fonts, the skip
 * link, navigation, the single `main` landmark and the footer (spec F.2, R).
 */
import '~/styles/global.css';

import plexRoman from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';
import stixRoman from '@fontsource-variable/stix-two-text/files/stix-two-text-latin-wght-normal.woff2?url';

import Footer from '~/components/Footer.astro';
import Nav from '~/components/Nav.astro';
import Seo, { type ShareImage } from '~/components/Seo.astro';
import { EARLY_SCRIPT } from '~/lib/early-script';

interface Props {
  /** The full document title, e.g. "Work | Josh Lennon" or "Josh Lennon". */
  title: string;
  description: string;
  /** Keeps a page out of search results (404, development pages, drafts). */
  noindex?: boolean;
  /** The page's share image (Seo.astro); the default card otherwise. */
  image?: ShareImage | undefined;
  /** Structured data for this page, beside the Person on every page. */
  structuredData?: (Record<string, unknown> | undefined)[];
}

const { title, description, noindex = false, image, structuredData } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Before the first paint: html.js and the stored intent (src/lib/early-script.ts). -->
    <script is:inline set:html={EARLY_SCRIPT} />
    <Seo
      title={title}
      description={description}
      noindex={noindex}
      image={image}
      structuredData={structuredData}
    />
    <!--
      The two roman files are preloaded (spec E.3, P.2): STIX for titles and the threshold,
      IBM Plex Sans for the text that is often the largest paint (the threshold sentence).
      The italics load only when used.
    -->
    <link rel="preload" href={stixRoman} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexRoman} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body>
    <!-- The skip link from the wizard's SCB site (SkipLink.tsx), on the portfolio's tokens. -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded focus:bg-paper focus:p-3 focus:text-ink focus:shadow-elevated"
      >Skip to main content</a
    >
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '~/scripts/intent';
    </script>
    {
      import.meta.env.DEV && (
        <script is:inline>
          // Development only (spec T.4): highlight every placeholder on the page so gaps are
          // visible. Production builds never contain placeholders at all.
          (() => {
            const mark = 'TODO' + '(josh)';
            const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
            const found = [];
            while (walker.nextNode()) {
              if (walker.currentNode.nodeValue.includes(mark)) found.push(walker.currentNode);
            }
            for (const node of found) {
              const highlight = document.createElement('mark');
              highlight.className = 'todo';
              highlight.textContent = node.nodeValue;
              node.replaceWith(highlight);
            }
          })();
        </script>
      )
    }
  </body>
</html>

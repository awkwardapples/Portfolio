---
/**
 * /dev/content: development only (integrations/dev-routes.mjs). Every work
 * entry, post and profile item, drafts included, so Josh can check new
 * content before it goes live. Placeholders are highlighted by BaseLayout.
 */
import { Image } from 'astro:assets';

import BaseLayout from '~/layouts/BaseLayout.astro';
import { dateOf, getPosts, getProfile, getWork } from '~/lib/content';
import { documentInfo } from '~/lib/documents';

const work = await getWork();
const posts = await getPosts();
const profile = await getProfile();

const day = (value: Date | string) =>
  dateOf(value)?.toISOString().slice(0, 10) ?? String(value);
---

<BaseLayout title="Content (dev) | Josh Lennon" description="Development content index." noindex>
  <div class="mx-auto max-w-5xl px-4 py-12">
    <h1 class="text-4xl font-semibold">Content</h1>
    <p class="mt-4">
      Development only. Drafts are listed with a draft label and are left out of production
      builds. Content problems are printed in the terminal running <code>pnpm dev</code>.
    </p>

    <h2 class="mt-12 text-2xl font-semibold">Work ({work.length})</h2>
    <ul class="mt-6 space-y-8">
      {
        work.map((entry) => (
          <li class="border-t border-rule pt-6">
            <p class="text-sm">
              {entry.id}, {entry.data.kind}, {day(entry.data.date)}
              {entry.data.draft && <strong> Draft</strong>}
              {entry.data.featured && <span> Featured {entry.data.featuredOrder}</span>}
            </p>
            <h3 class="mt-1 text-xl font-semibold">{entry.data.title}</h3>
            {entry.data.subtitle && <p class="mt-1">{entry.data.subtitle}</p>}
            <p class="mt-2">{entry.data.summary}</p>
            <p class="mt-2 text-sm">
              Role: {entry.data.role}. Authorship: {entry.data.authorship.type}.
            </p>
            {entry.data.documents.length > 0 && (
              <ul class="mt-4 flex flex-wrap gap-6">
                {entry.data.documents.map((doc) => {
                  const info = documentInfo(doc.file);
                  return (
                    <li class="w-40">
                      {info?.cover && (
                        <Image src={info.cover} alt="" width={160} class="border border-rule" />
                      )}
                      <p class="mt-2 text-sm">
                        <a class="underline" href={info?.url ?? '#'}>
                          {doc.title}
                        </a>
                        {info ? `, ${info.pages} pages, ${info.size}` : ', not recorded yet'}
                      </p>
                    </li>
                  );
                })}
              </ul>
            )}
            {entry.data.media.length > 0 && (
              <p class="mt-2 text-sm">
                Media: {entry.data.media.map((item) => item.type).join(', ')}
              </p>
            )}
          </li>
        ))
      }
    </ul>

    <h2 class="mt-12 text-2xl font-semibold">Posts ({posts.length})</h2>
    {posts.length === 0 && <p class="mt-4">No posts yet. Add one with <code>pnpm new post</code>.</p>}
    <ul class="mt-6 space-y-6">
      {
        posts.map((post) => (
          <li class="border-t border-rule pt-4">
            <p class="text-sm">
              /log/{post.id}, {day(post.data.date)}, {post.data.threads.join(', ')}
              {post.data.draft && <strong> Draft</strong>}
            </p>
            <h3 class="mt-1 text-lg font-semibold">{post.data.title}</h3>
            <p class="mt-1">{post.data.summary}</p>
          </li>
        ))
      }
    </ul>

    <h2 class="mt-12 text-2xl font-semibold">Profile</h2>
    <p class="mt-4">{profile.name}, {profile.headline.role}</p>
    <p class="mt-2">{profile.bioShort}</p>
    <h3 class="mt-6 font-semibold">Experience</h3>
    <ul class="mt-2 space-y-2">
      {
        profile.experience.map((item) => (
          <li>
            {item.title}, {item.organisation}, from {item.start}
            {item.draft && <strong> Draft</strong>}
          </li>
        ))
      }
    </ul>
    <h3 class="mt-6 font-semibold">Education</h3>
    <ul class="mt-2 space-y-2">
      {
        profile.education.map((item) => (
          <li>
            {item.qualification}, {item.institution}, {item.start} to {item.end ?? 'now'}
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
